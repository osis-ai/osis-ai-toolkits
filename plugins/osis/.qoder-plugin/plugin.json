{
  "name": "osis",
  "displayName": "OSIS",
  "version": "0.2.18",
  "description": "OSIS Agent plugin: instance selection, API help and Python execution through the local OSIS Agent Broker.",
  "author": {
    "name": "OSIS AI Team"
  },
  "homepage": "https://github.com/osis-ai/osis-ai-toolkits",
  "repository": "https://github.com/osis-ai/osis-ai-toolkits",
  "license": "MIT",
  "keywords": [
    "osis",
    "bridge",
    "fea",
    "modeling",
    "python"
  ],
  "mcpServers": {
    "osis": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "%USERPROFILE%\\.osisai\\.venv\\Scripts\\python.exe",
        "-P",
        "-m",
        "osis_broker",
        "--stdio"
      ]
    },
    "weknora": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "%USERPROFILE%\\.osisai\\.venv\\Scripts\\python.exe",
        "-P",
        "-m",
        "weknora_mcp_server"
      ],
      "env": {
        "WEKNORA_BASE_URL": "https://knowledge.osisbim.com/api/v1"
      }
    }
  }
}
