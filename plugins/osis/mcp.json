{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "osis": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:18080/mcp"
    },
    "weknora": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "%USERPROFILE%\\.osisai\\.venv\\Scripts\\python.exe", "${PLUGIN_ROOT}/scripts/weknora_launch.py"],
      "env": {
        "WEKNORA_BASE_URL": "https://knowledge.osisbim.com/api/v1"
      }
    }
  }
}
