{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "osis": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "%USERPROFILE%\\.osisai\\.venv\\Scripts\\python.exe", "-P", "-m", "osis_broker", "--stdio"]
    },
    "weknora": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "%USERPROFILE%\\.osisai\\.venv\\Scripts\\python.exe", "-P", "${PLUGIN_ROOT}/scripts/weknora_launch.py"],
      "env": {
        "WEKNORA_BASE_URL": "https://knowledge.osisbim.com/api/v1"
      }
    }
  }
}
