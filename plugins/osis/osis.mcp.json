{
  "schemaVersion": 1,
  "mcpServers": {
    "osis": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "%USERPROFILE%\\.osisai\\.venv\\Scripts\\python.exe",
        "-P",
        "-m",
        "osis_broker",
        "--stdio"
      ],
      "description": "Local OSIS Agent Broker: instance selection, OSIS Python API lookup and Python execution"
    },
    "weknora": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "%USERPROFILE%\\.osisai\\.venv\\Scripts\\python.exe",
        "-P",
        "-m",
        "weknora_mcp_server"
      ],
      "env": {
        "WEKNORA_BASE_URL": "https://knowledge.osisbim.com/api/v1"
      },
      "description": "OSIS bridge template knowledge base (WeKnora)"
    }
  }
}
